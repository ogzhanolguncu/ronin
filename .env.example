# Required in production. The passphrase users must enter to log in.
# PASSPHRASE=your-secret-here

# Set to 1 to skip auth entirely (no PASSPHRASE needed).
# Use in local development when running the Go backend alongside `make web`.
# DEV=1

# Set to 1 to allow the session cookie over plain HTTP (no TLS).
# Required when serving without a reverse proxy (e.g. direct localhost testing).
# INSECURE_COOKIE=1

